{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["mise.toml"],
  "tasks": {
    "//#build:pkg": {
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "scripts/clean/**", "tsconfig.json"]
    },
    "build": {
      "dependsOn": ["//#build:pkg"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**"]
    },
    "//#test:run": {
      "dependsOn": ["//#build:pkg", "//#lint:run", "//#typecheck:run"],
      "outputs": []
    },
    "test:run": {
      "dependsOn": ["//#build:pkg"],
      "outputs": []
    },
    "//#test:unit:run": {
      "dependsOn": ["//#build:pkg", "//#lint:run", "//#typecheck:run"],
      "outputs": []
    },
    "//#test:integration:run": {
      "dependsOn": ["//#build:pkg", "//#lint:run", "//#typecheck:run"],
      "outputs": []
    },
    "//#test:e2e:run": {
      "dependsOn": ["//#build:pkg", "//#lint:run", "//#typecheck:run"],
      "outputs": []
    },
    "//#lint:run": {
      "cache": false
    },
    "//#format:run": {
      "cache": false
    },
    "format:run": {
      "cache": false
    },
    "//#typecheck:run": {
      "inputs": ["src/**", "tests/**", "scripts/**", "*.config.ts", "tsconfig.json"],
      "outputs": []
    },
    "typecheck:run": {
      "dependsOn": ["//#build:pkg"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["//#build:pkg"],
      "cache": false,
      "persistent": true
    }
  }
}
