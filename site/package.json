{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4747",
    "dev:next": "next dev --port 4747",
    "build": "vite build",
    "test": "bun run test:run",
    "test:run": "bun test ./tests",
    "test:runtime": "playwright test",
    "typecheck": "bun run typecheck:run",
    "typecheck:run": "tsc --noEmit",
    "lint:docs": "oxlint --config oxlint.config.ts --deny-warnings src/components/Header src/components/Layout src/components/Sidebar src/components/DocsNavigation src/components/DocsOutline tests/unit/docs tests/e2e/docs mdx.config.ts next.config.ts vite.config.ts oxlint.config.ts",
    "format": "bun run format:run",
    "format:run": "oxfmt --write src tests *.config.ts mdx-components.tsx package.json tsconfig.json",
    "format:check": "oxfmt --check src tests *.config.ts mdx-components.tsx package.json tsconfig.json"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/db": "^0.5.33",
    "@tanstack/query-persist-client-core": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "effect": "^4.1.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "xldx": "workspace:*"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "playwright": "1.64.1",
    "react-server-dom-webpack": "19.3.1",
    "rehype-slug": "6.0.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vinext": "1.4.5",
    "vite": "8.3.5"
  },
  "peerDependencies": {},
  "optionalDependencies": {}
}
